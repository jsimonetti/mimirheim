#!/command/with-contenv sh
exec 2>&1
# ENABLE_ZONNEPLAN is set by cont-init.d/00-options-env.sh when running as a
# HA add-on. Must equal the literal string "true" to start; unset or any
# other value keeps the service down (ADR-0013, fail-closed).
if [ "${ENABLE_ZONNEPLAN}" != "true" ]; then
    echo "zonneplan: disabled (set ENABLE_ZONNEPLAN=true to enable)"
    /command/s6-svc -d /run/service/zonneplan
    exit 0
fi
CONFIG=/config/zonneplan.yaml
exec /app/.venv/bin/python -m zonneplan_prices --config "$CONFIG"
