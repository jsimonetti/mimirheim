#!/command/with-contenv sh
exec 2>&1
if [ "${ENABLE_BASELOAD_HA_DB}" != "true" ]; then
    echo "baseload-ha-db: disabled (set ENABLE_BASELOAD_HA_DB=true to enable)"
    /command/s6-svc -d /run/service/baseload-ha-db
    exit 0
fi
CONFIG=/config/baseload-ha-db.yaml
exec /app/.venv/bin/python -m baseload_ha_db --config "$CONFIG"
