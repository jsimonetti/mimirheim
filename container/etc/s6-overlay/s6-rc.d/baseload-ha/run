#!/command/with-contenv sh
exec 2>&1
if [ "${ENABLE_BASELOAD_HA}" != "true" ]; then
    echo "baseload-ha: disabled (set ENABLE_BASELOAD_HA=true to enable)"
    /command/s6-svc -d /run/service/baseload-ha
    exit 0
fi
CONFIG=/config/baseload-ha.yaml
exec /app/.venv/bin/python -m baseload_ha --config "$CONFIG"
