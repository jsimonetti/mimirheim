#!/command/with-contenv sh
exec 2>&1
if [ "${ENABLE_PV_FETCHER}" != "true" ]; then
    echo "pv-fetcher: disabled (set ENABLE_PV_FETCHER=true to enable)"
    /command/s6-svc -d /run/service/pv-fetcher
    exit 0
fi
CONFIG=/config/pv-fetcher.yaml
exec /app/.venv/bin/python -m pv_fetcher --config "$CONFIG"
