#!/command/with-contenv sh
exec 2>&1
if [ "${ENABLE_BASELOAD_STATIC}" != "true" ]; then
    echo "baseload-static: disabled (set ENABLE_BASELOAD_STATIC=true to enable)"
    /command/s6-svc -d /run/service/baseload-static
    exit 0
fi
CONFIG=/config/baseload-static.yaml
exec /app/.venv/bin/python -m baseload_static --config "$CONFIG"
