#!/command/with-contenv sh
exec 2>&1
# ENABLE_EPEXPREDICTOR is set by cont-init.d/00-options-env.sh when running as a
# HA add-on. When unset (plain Docker), default to true so the service runs
# unless explicitly disabled.
if [ "${ENABLE_EPEXPREDICTOR:-true}" != "true" ]; then
    echo "epexpredictor: disabled via add-on options"
    /command/s6-svc -d /run/service/epexpredictor
    exit 0
fi
CONFIG=/config/epexpredictor.yaml
exec /app/.venv/bin/python -m epexpredictor_prices --config "$CONFIG"
