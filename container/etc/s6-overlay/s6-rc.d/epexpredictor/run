#!/command/with-contenv sh
exec 2>&1
# ENABLE_EPEXPREDICTOR is set by cont-init.d/00-options-env.sh when running as a
# HA add-on. Must equal the literal string "true" to start; unset or any
# other value keeps the service down (ADR-0013, fail-closed).
if [ "${ENABLE_EPEXPREDICTOR}" != "true" ]; then
    echo "epexpredictor: disabled (set ENABLE_EPEXPREDICTOR=true to enable)"
    /command/s6-svc -d /run/service/epexpredictor
    exit 0
fi
CONFIG=/config/epexpredictor.yaml
exec /app/.venv/bin/python -m epexpredictor_prices --config "$CONFIG"
