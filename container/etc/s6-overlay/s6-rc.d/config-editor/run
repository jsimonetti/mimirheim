#!/command/with-contenv sh
exec 2>&1
if [ "${ENABLE_CONFIG_EDITOR}" != "true" ]; then
    echo "config-editor: disabled (set ENABLE_CONFIG_EDITOR=true to enable)"
    /command/s6-svc -d /run/service/config-editor
    exit 0
fi
CONFIG=/config/config-editor.yaml
exec /app/.venv/bin/python -m config_editor --config "$CONFIG"
