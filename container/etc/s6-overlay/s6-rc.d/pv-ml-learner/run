#!/command/with-contenv sh
exec 2>&1
if [ "${ENABLE_PV_ML_LEARNER}" != "true" ]; then
    echo "pv-ml-learner: disabled (set ENABLE_PV_ML_LEARNER=true to enable)"
    /command/s6-svc -d /run/service/pv-ml-learner
    exit 0
fi
CONFIG=/config/pv-ml-learner.yaml
exec /app/.venv/bin/python -m pv_ml_learner --config "$CONFIG"
