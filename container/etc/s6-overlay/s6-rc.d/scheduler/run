#!/command/with-contenv sh
exec 2>&1
if [ "${ENABLE_SCHEDULER}" != "true" ]; then
    echo "scheduler: disabled (set ENABLE_SCHEDULER=true to enable)"
    /command/s6-svc -d /run/service/scheduler
    exit 0
fi
CONFIG=/config/scheduler.yaml
exec /app/.venv/bin/python -m scheduler --config "$CONFIG"
